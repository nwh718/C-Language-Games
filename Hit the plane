#include <stdio.h>
#include <stdlib.h>
#include <windows.h>
#include <conio.h>
#include <time.h>

#define ESC_KEY    27
#define UP_KEY     72
#define DOWN_KEY   80
#define LEFT_KEY   75
#define RIGHT_KEY  77
#define SPACE_KEY  32
#define BOARD_SIZE 20
#define PLAYER_MIN 1
#define PLAYER_MAX 18
#define ENEMY_MAX_X 17
#define ENEMY_COUNT 3

typedef struct {
    int x;
    int y;
    const char *sprite;
} Player;

typedef struct {
    int x;
    int y;
    int active;
    const char *sprite;
} Bullet;

typedef struct {
    int x;
    int y;
    int score;
    int alive;
    const char *sprite;
    const char *hit_sprite;
} Enemy;

typedef enum {
    STATE_RUNNING,
    STATE_GAMEOVER,
    STATE_QUIT
} GameStateEnum;

typedef struct {
    Player  player;
    Bullet  bullet;
    Enemy   enemies[ENEMY_COUNT];
    GameStateEnum state;
    int     score;
    int     total_spawned;
    int     destroyed;
} GameState;

void gotoxy(int x, int y)
{
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

void cursor_hide(void)
{
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    CONSOLE_CURSOR_INFO cci;
    GetConsoleCursorInfo(hOut, &cci);
    cci.bVisible = 0;
    SetConsoleCursorInfo(hOut, &cci);
}

void show_instructions(void)
{
    printf("\t\t\t\n\n\n\n");
    printf("\t\t\t  方向控制\n\n"
           "\t\t\t  上  ↑\n\n"
           "\t\t\t  下  ↓\n\n"
           "\t\t\t  左  ←\n\n"
           "\t\t\t  右  →\n\n"
           "\t\t\t  子弹 空格\n\n\n"
           "\t\t\t  退出请按 ESC\n");
    gotoxy(0, 0);
}

void draw_border(void)
{
    int i, n;
    for (i = 0; i <= BOARD_SIZE; i++) {
        for (n = 0; n <= BOARD_SIZE; n++) {
            printf("*");
        }
        printf("\n");
    }
    for (i = 1; i <= BOARD_SIZE - 1; i++) {
        for (n = 1; n <= BOARD_SIZE - 1; n++) {
            gotoxy(i, n);
            printf(" ");
        }
    }
}

void draw_status(const GameState *game)
{
    gotoxy(22, 2);
    printf("分数: %d   ", game->score);
}

void clear_cell(int x, int y)
{
    gotoxy(x, y);
    printf(" ");
}

void draw_player(const GameState *game)
{
    gotoxy(game->player.x, game->player.y);
    printf("%s", game->player.sprite);
}

int can_move_to(const GameState *game, int nx, int ny)
{
    return (nx >= PLAYER_MIN && nx <= PLAYER_MAX &&
            ny >= PLAYER_MIN && ny <= PLAYER_MAX);
}

void move_player(GameState *game, int dx, int dy)
{
    int nx = game->player.x + dx;
    int ny = game->player.y + dy;
    if (!can_move_to(game, nx, ny)) return;
    clear_cell(game->player.x, game->player.y);
    game->player.x = nx;
    game->player.y = ny;
    draw_player(game);
}

void enemy_init(Enemy *e, const char *sprite, const char *hit, int score, int x, int y)
{
    e->x = x;
    e->y = y;
    e->score = score;
    e->alive = 1;
    e->sprite = sprite;
    e->hit_sprite = hit;
}

void enemy_respawn(GameState *game, Enemy *e)
{
    e->x = rand() % ENEMY_MAX_X + 1;
    e->y = 1;
    e->alive = 1;
    game->total_spawned++;
}

void game_init(GameState *game)
{
    game->player.x = 10;
    game->player.y = 18;
    game->player.sprite = "Ж";

    game->bullet.x = 10;
    game->bullet.y = 18;
    game->bullet.active = 0;
    game->bullet.sprite = "θ";

    enemy_init(&game->enemies[0], "Ψ", "3", 2, 5, 1);
    enemy_init(&game->enemies[1], "ж", "1", 3, 10, 1);
    enemy_init(&game->enemies[2], "♀", "0", 1, 15, 1);

    game->state = STATE_RUNNING;
    game->score = 0;
    game->total_spawned = ENEMY_COUNT;
    game->destroyed = 0;
}

int player_hit_by_enemy(const GameState *game)
{
    int i;
    for (i = 0; i < ENEMY_COUNT; i++) {
        if (!game->enemies[i].alive) continue;
        if (game->player.x == game->enemies[i].x &&
            game->player.y == game->enemies[i].y) {
            return 1;
        }
    }
    return 0;
}

int bullet_hit_enemy_index(const GameState *game)
{
    int i;
    if (!game->bullet.active) return -1;
    for (i = 0; i < ENEMY_COUNT; i++) {
        if (!game->enemies[i].alive) continue;
        if (game->bullet.x == game->enemies[i].x &&
            game->bullet.y == game->enemies[i].y) {
            return i;
        }
    }
    return -1;
}

void draw_hit_effect(const Enemy *target)
{
    gotoxy(target->x, target->y);
    printf("%s", target->hit_sprite);
    Sleep(200);
    clear_cell(target->x, target->y);
}

void process_bullet_hit(GameState *game, int enemy_idx)
{
    Enemy *target = &game->enemies[enemy_idx];
    draw_hit_effect(target);
    game->score += target->score;
    game->destroyed++;
    target->alive = 0;
    target->y = 0;
    game->bullet.active = 0;
    draw_status(game);
    draw_player(game);
}

void draw_bullet_step(const GameState *game)
{
    gotoxy(game->bullet.x, game->bullet.y);
    printf("%s", game->bullet.sprite);
    Sleep(10);
}

void fire_bullet(GameState *game)
{
    int hit_idx;

    game->bullet.x = game->player.x;
    game->bullet.y = game->player.y;
    game->bullet.active = 1;

    while (game->bullet.active && game->bullet.y > PLAYER_MIN) {
        game->bullet.y--;
        draw_bullet_step(game);

        hit_idx = bullet_hit_enemy_index(game);
        if (hit_idx >= 0) {
            process_bullet_hit(game, hit_idx);
        } else {
            clear_cell(game->bullet.x, game->bullet.y);
        }
    }

    game->bullet.active = 0;
    draw_player(game);
}

void wait_any_key(void)
{
    while (!kbhit()) {
        Sleep(500);
        gotoxy(1, 12);
        printf(" 继续请按任意键...    ");
        Sleep(900);
        gotoxy(1, 12);
        printf("                    ");
    }
    while (kbhit()) getch();
}

void show_gameover_screen(const GameState *game)
{
    float accuracy = 0.0f;
    if (game->total_spawned > 0) {
        accuracy = (float)game->destroyed / (float)game->total_spawned * 100.0f;
    }
    gotoxy(1, 3);
    printf(" !!! 游戏结束 !!!\n"
           "*******************\n"
           " 您的总得分: %d\n\n"
           " 敌机数: %d\n"
           " 歼敌数: %d\n"
           " 命中率: %.0f %%\n"
           "*******************\n",
           game->score,
           game->total_spawned,
           game->destroyed,
           accuracy);
}

void game_restart(GameState *game)
{
    wait_any_key();
    gotoxy(0, 0);
    draw_border();
    game_init(game);
    draw_status(game);
    draw_player(game);
}

void draw_enemy(const Enemy *e)
{
    if (!e->alive) return;
    gotoxy(e->x, e->y);
    printf("%s", e->sprite);
}

void spawn_dead_enemies(GameState *game)
{
    int i;
    for (i = 0; i < ENEMY_COUNT; i++) {
        if (!game->enemies[i].alive && game->enemies[i].y == 0) {
            enemy_respawn(game, &game->enemies[i]);
        }
    }
}

void update_enemy_positions(GameState *game)
{
    int i;
    for (i = 0; i < ENEMY_COUNT; i++) {
        if (!game->enemies[i].alive) continue;
        clear_cell(game->enemies[i].x, game->enemies[i].y);
        game->enemies[i].y++;

        if (game->enemies[i].y > PLAYER_MAX) {
            game->enemies[i].alive = 0;
            game->enemies[i].y = 0;
        } else {
            draw_enemy(&game->enemies[i]);
        }
    }
}

void update_enemies(GameState *game)
{
    spawn_dead_enemies(game);
    update_enemy_positions(game);
    Sleep(900);

    if (player_hit_by_enemy(game)) {
        show_gameover_screen(game);
        game_restart(game);
    }
}

void process_player_input(GameState *game, int key)
{
    switch (key) {
    case UP_KEY:    move_player(game, 0, -1); break;
    case DOWN_KEY:  move_player(game, 0,  1); break;
    case LEFT_KEY:  move_player(game, -1, 0); break;
    case RIGHT_KEY: move_player(game, 1,  0); break;
    case SPACE_KEY: fire_bullet(game);         break;
    case ESC_KEY:   game->state = STATE_QUIT;  return;
    }
}

void handle_input(GameState *game)
{
    int key;
    while (kbhit()) {
        key = getch();
        if (key == 0 || key == 224) key = getch();
        process_player_input(game, key);
        if (game->state != STATE_RUNNING) return;
        if (player_hit_by_enemy(game)) {
            show_gameover_screen(game);
            game_restart(game);
            return;
        }
    }
}

void game_loop(GameState *game)
{
    while (game->state == STATE_RUNNING) {
        handle_input(game);
        if (game->state != STATE_RUNNING) break;
        update_enemies(game);
    }
}

int main(void)
{
    GameState game;
    srand((unsigned)time(NULL));
    show_instructions();
    cursor_hide();
    draw_border();
    game_init(&game);
    draw_status(&game);
    draw_player(&game);
    game_loop(&game);
    return 0;
}