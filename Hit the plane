#include <stdio.h>
#include <stdlib.h>
#include <windows.h>
#include <conio.h>
#include <time.h>

#define Esc 27
#define Up 72
#define Down 80
#define Left 75
#define Right 77
#define Kong 32
#define BOARD_SIZE 20
#define PLAYER_MIN_POS 1
#define PLAYER_MAX_POS 18
#define ENEMY_MAX_X 17
#define ENEMY_COUNT 3

typedef struct
{
    int x;
    int y;
    const char *sprite;
} Player;

typedef struct
{
    int x;
    int y;
    int active;
    const char *sprite;
} Bullet;

typedef struct
{
    int x;
    int y;
    int score;
    const char *sprite;
    const char *hit_sprite;
} Enemy;

typedef struct
{
    Player player;
    Bullet bullet;
    Enemy enemies[ENEMY_COUNT];
    int running;
    int score;
    int total_enemies;
    int destroyed_enemies;
} GameState;

void gotoxy(int x, int y)
{
    COORD coord;
    coord.X = x;
    coord.Y = y;
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

void hidden(void)
{
    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
    CONSOLE_CURSOR_INFO cci;
    GetConsoleCursorInfo(hOut, &cci);
    cci.bVisible = 0;
    SetConsoleCursorInfo(hOut, &cci);
}

void shuoming(void)
{
    printf("\t\t\t\n\n\n\n");
    printf("\t\t\t方向控制\n\n"
           "\t\t\t上 ↑\n\n"
           "\t\t\t下 ↓\n\n"
           "\t\t\t左 ←\n\n"
           "\t\t\t右 →\n\n"
           "\t\t\t子弹 空格\n\n\n"
           "\t\t\t退出请按 ESC\n");
    gotoxy(0, 0);
}

void huatu(void)
{
    int i;
    int n;

    for (i = 0; i <= BOARD_SIZE; i++)
    {
        for (n = 0; n <= BOARD_SIZE; n++)
        {
            printf("*");
        }
        printf("\n");
    }

    for (i = 1; i <= 19; i++)
    {
        for (n = 1; n <= 19; n++)
        {
            gotoxy(i, n);
            printf(" ");
        }
    }
}

void draw_status(const GameState *game)
{
    gotoxy(22, 2);
    printf("分数: %d   ", game->score);
}

void clear_at(int x, int y)
{
    if (x >= 0 && y >= 0)
    {
        gotoxy(x, y);
        printf(" ");
    }
}

void draw_player(const GameState *game)
{
    gotoxy(game->player.x, game->player.y);
    printf("%s", game->player.sprite);
}

void move_player(GameState *game, int dx, int dy)
{
    int next_x = game->player.x + dx;
    int next_y = game->player.y + dy;

    if (next_x < PLAYER_MIN_POS || next_x > PLAYER_MAX_POS || next_y < PLAYER_MIN_POS || next_y > PLAYER_MAX_POS)
    {
        return;
    }

    clear_at(game->player.x, game->player.y);
    game->player.x = next_x;
    game->player.y = next_y;
    draw_player(game);
}

void init_enemy(Enemy *enemy, const char *sprite, const char *hit_sprite, int score, int x, int y)
{
    enemy->x = x;
    enemy->y = y;
    enemy->score = score;
    enemy->sprite = sprite;
    enemy->hit_sprite = hit_sprite;
}

void reset_enemy(GameState *game, Enemy *enemy)
{
    enemy->x = rand() % ENEMY_MAX_X + 1;
    enemy->y = 0;
    game->total_enemies++;
}

void initialize_round(GameState *game)
{
    game->player.x = 10;
    game->player.y = 18;
    game->player.sprite = "Ж";

    game->bullet.x = game->player.x;
    game->bullet.y = game->player.y;
    game->bullet.active = 0;
    game->bullet.sprite = "θ";

    init_enemy(&game->enemies[0], "Ψ", "3", 2, 10, 1);
    init_enemy(&game->enemies[1], "ж", "1", 3, 10, 1);
    init_enemy(&game->enemies[2], "♀", "0", 1, 10, 1);

    game->running = 1;
    game->score = 0;
    game->total_enemies = ENEMY_COUNT;
    game->destroyed_enemies = 0;
}

int is_player_hit(const GameState *game)
{
    int i;

    for (i = 0; i < ENEMY_COUNT; i++)
    {
        if (game->player.x == game->enemies[i].x && game->player.y == game->enemies[i].y)
        {
            return 1;
        }
    }

    return 0;
}

Enemy *find_bullet_target(GameState *game)
{
    int i;

    for (i = 0; i < ENEMY_COUNT; i++)
    {
        if (game->bullet.active && game->bullet.x == game->enemies[i].x && game->bullet.y == game->enemies[i].y)
        {
            return &game->enemies[i];
        }
    }

    return NULL;
}

int resolve_bullet_collision(GameState *game)
{
    Enemy *target = find_bullet_target(game);

    if (target == NULL)
    {
        return 0;
    }

    gotoxy(target->x, target->y);
    printf("%s", target->hit_sprite);
    Sleep(200);
    clear_at(target->x, target->y);

    game->score += target->score;
    game->destroyed_enemies++;
    target->y = 0;
    game->bullet.active = 0;
    draw_status(game);
    draw_player(game);

    return 1;
}

void fire_bullet(GameState *game)
{
    game->bullet.x = game->player.x;
    game->bullet.y = game->player.y;
    game->bullet.active = 1;

    while (game->bullet.active && game->bullet.y > PLAYER_MIN_POS)
    {
        game->bullet.y--;
        gotoxy(game->bullet.x, game->bullet.y);
        printf("%s", game->bullet.sprite);
        Sleep(10);

        if (!resolve_bullet_collision(game))
        {
            clear_at(game->bullet.x, game->bullet.y);
        }
    }

    game->bullet.active = 0;
    draw_player(game);
}

void wait_for_restart_key(void)
{
    while (!kbhit())
    {
        Sleep(500);
        gotoxy(1, 12);
        printf(" 继续请按任意键...    ");
        Sleep(900);
        gotoxy(1, 12);
        printf("                    ");
    }

    while (kbhit())
    {
        getch();
    }
}

void handle_game_over(GameState *game)
{
    float accuracy = 0.0f;

    if (game->total_enemies > 0)
    {
        accuracy = ((float)game->destroyed_enemies / (float)game->total_enemies) * 100.0f;
    }

    gotoxy(1, 3);
    printf(" !!! 游戏结束 !!!\n"
           "*******************\n"
           " 您的总得分: %d\n\n"
           " 敌机数: %d\n"
           " 歼敌数: %d\n"
           " 命中率: %.0f %%\n"
           "*******************\n",
           game->score,
           game->total_enemies,
           game->destroyed_enemies,
           accuracy);

    wait_for_restart_key();
    gotoxy(0, 0);
    huatu();
    initialize_round(game);
    draw_status(game);
    draw_player(game);
}

void update_enemies(GameState *game)
{
    int i;

    for (i = 0; i < ENEMY_COUNT; i++)
    {
        if (game->enemies[i].y == 0)
        {
            reset_enemy(game, &game->enemies[i]);
        }

        game->enemies[i].y++;
        gotoxy(game->enemies[i].x, game->enemies[i].y);
        printf("%s", game->enemies[i].sprite);
    }

    Sleep(900);

    if (is_player_hit(game))
    {
        handle_game_over(game);
        return;
    }

    for (i = 0; i < ENEMY_COUNT; i++)
    {
        clear_at(game->enemies[i].x, game->enemies[i].y);
        if (game->enemies[i].y == PLAYER_MAX_POS)
        {
            game->enemies[i].y = 0;
        }
    }

    draw_player(game);
}

void handle_input(GameState *game)
{
    int key;

    while (kbhit())
    {
        key = getch();
        if (key == 0 || key == 224)
        {
            key = getch();
        }

        switch (key)
        {
        case Up:
            move_player(game, 0, -1);
            break;
        case Down:
            move_player(game, 0, 1);
            break;
        case Left:
            move_player(game, -1, 0);
            break;
        case Right:
            move_player(game, 1, 0);
            break;
        case Kong:
            fire_bullet(game);
            break;
        case Esc:
            game->running = 0;
            return;
        default:
            break;
        }

        if (is_player_hit(game))
        {
            handle_game_over(game);
            return;
        }
    }
}

void run_game(GameState *game)
{
    while (game->running)
    {
        handle_input(game);
        if (!game->running)
        {
            break;
        }
        update_enemies(game);
    }
}

int main(void)
{
    GameState game;

    srand((unsigned)time(NULL));
    shuoming();
    hidden();
    huatu();
    initialize_round(&game);
    draw_status(&game);
    draw_player(&game);
    run_game(&game);

    return 0;
}
