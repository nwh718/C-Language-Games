三、关键函数重构对照
--------------------------------------------------------------------------------

>> 3.1 敌机生成 —— Bug 修复

--- v2.3.2: 每次 y==0 触发都递增 total_enemies（错误）
    void reset_enemy(GameState *game, Enemy *enemy)
    {
        enemy->x = rand() % ENEMY_MAX_X + 1;
        enemy->y = 0;
        game->total_enemies++;
    }

+++ v2.3.3: 用 alive 控制，仅在真正重生时递增 total_spawned
    void enemy_respawn(GameState *game, Enemy *e)
    {
        e->x = rand() % ENEMY_MAX_X + 1;
        e->y = 1;
        e->alive = 1;
        game->total_spawned++;
    }

    void spawn_dead_enemies(GameState *game)
    {
        int i;
        for (i = 0; i < ENEMY_COUNT; i++) {
            if (!game->enemies[i].alive && game->enemies[i].y == 0) {
                enemy_respawn(game, &game->enemies[i]);
            }
        }
    }


>> 3.2 碰撞检测 —— 逻辑/渲染分离

--- v2.3.2: 一个函数混合查找、渲染、状态修改
    int resolve_bullet_collision(GameState *game)
    {
        Enemy *target = find_bullet_target(game);
        if (target == NULL) return 0;

        gotoxy(target->x, target->y);          // 渲染
        printf("%s", target->hit_sprite);       // 渲染
        Sleep(200);                             // 渲染
        clear_at(target->x, target->y);         // 渲染

        game->score += target->score;           // 逻辑
        game->destroyed_enemies++;              // 逻辑
        target->y = 0;                          // 逻辑（隐式标记死亡）
        game->bullet.active = 0;                // 逻辑
        draw_status(game);                      // 渲染
        draw_player(game);                      // 渲染
        return 1;
    }

+++ v2.3.3: 拆分为纯逻辑查询 + 独立渲染 + 独立状态处理
    int bullet_hit_enemy_index(const GameState *game)    // 纯逻辑
    {
        int i;
        if (!game->bullet.active) return -1;
        for (i = 0; i < ENEMY_COUNT; i++) {
            if (!game->enemies[i].alive) continue;
            if (game->bullet.x == game->enemies[i].x &&
                game->bullet.y == game->enemies[i].y) {
                return i;
            }
        }
        return -1;
    }

    void draw_hit_effect(const Enemy *target)            // 纯渲染
    {
        gotoxy(target->x, target->y);
        printf("%s", target->hit_sprite);
        Sleep(200);
        clear_cell(target->x, target->y);
    }

    void process_bullet_hit(GameState *game, int idx)    // 纯逻辑
    {
        Enemy *target = &game->enemies[idx];
        draw_hit_effect(target);
        game->score += target->score;
        game->destroyed++;
        target->alive = 0;
        target->y = 0;
        game->bullet.active = 0;
        draw_status(game);
        draw_player(game);
    }


>> 3.3 敌机更新 —— 单一大函数拆解

--- v2.3.2: update_enemies() 一个函数做所有事
    void update_enemies(GameState *game)
    {
        int i;
        for (i = 0; i < ENEMY_COUNT; i++) {
            if (game->enemies[i].y == 0)
                reset_enemy(game, &game->enemies[i]);  // 生成
            game->enemies[i].y++;
            gotoxy(...); printf(...);                    // 渲染
        }
        Sleep(900);
        if (is_player_hit(game)) {                       // 碰撞
            handle_game_over(game);                      // 结算+重启
            return;
        }
        for (i = 0; i < ENEMY_COUNT; i++) {
            clear_at(...);                                // 清理
            if (game->enemies[i].y == PLAYER_MAX_POS)
                game->enemies[i].y = 0;
        }
        draw_player(game);
    }

+++ v2.3.3: 拆分为 spawn + update_positions + 上层编排
    void spawn_dead_enemies(GameState *game)        // 职责1：生成
    { ... }

    void update_enemy_positions(GameState *game)    // 职责2：移动+渲染+清理
    {
        int i;
        for (i = 0; i < ENEMY_COUNT; i++) {
            if (!game->enemies[i].alive) continue;
            clear_cell(game->enemies[i].x, game->enemies[i].y);
            game->enemies[i].y++;
            if (game->enemies[i].y > PLAYER_MAX) {
                game->enemies[i].alive = 0;
                game->enemies[i].y = 0;
            } else {
                draw_enemy(&game->enemies[i]);
            }
        }
    }

    void update_enemies(GameState *game)            // 职责3：编排+碰撞
    {
        spawn_dead_enemies(game);
        update_enemy_positions(game);
        Sleep(900);
        if (player_hit_by_enemy(game)) {
            show_gameover_screen(game);              // 纯显示
            game_restart(game);                      // 纯重启
        }
    }


